DISCORD_TOKEN=your_token_here
DATABASE_URL=sqlite:data/bot.db
ZULIP_API_KEY=your_zulip_api_key_here
POCKETBASE_IMPERSONATE_AUTH_TOKEN=your_pb_token_here

# Part lookups for /part, the /build part picker and part autocomplete.
# Without it every part lookup fails, indistinguishably from a network error,
# and autocomplete falls back to the built-in catalogue of everyday sizes.
# Free key from https://rebrickable.com/api/
REBRICKABLE_API_KEY=your_rebrickable_api_key_here

# Set lookups for /set. Optional; /set is the only thing that uses it.
BRICKSET_API_KEY=your_brickset_api_key_here
