# Global bot name (optional)
# bot_name = "Palikkaharrastaja"
# Global default locale (optional; guild config wins, and "fi-FI" applies when neither is set)
# locale = "fi-FI"

# Every table refuses keys it does not know, so a key written under the wrong
# table header is reported at startup instead of silently ignored. Run
# `brickbot --explain-config` to see what the file enables in each guild.

# Ambient assistant: offers /set and /part when chat looks like it needs them.
# Every key can be overridden per guild in [guilds.ambient]; see [[guilds]].
# [ambient]
# set = true
# part = true
# debug_logging = false
#
# # Training-data capture for every guild (off unless enabled). A guild's own
# # [guilds.ambient.training_data] replaces this one for that guild.
# [ambient.training_data]
# enabled = false
# retention_days = 30
# store_raw_text = false

# [resource_limits]
# max_http_body_bytes = 10485760   # 10 MiB
# max_cache_memory_bytes = 52428800 # 50 MiB of cached HTTP responses
# cache_ttl_secs = 600

# Zulip Integration (optional)
# [zulip]
# url = "https://forum.palikkaharrastajat.fi"
# bot_email = "palikkaharrastajat-bot@forum.palikkaharrastajat.fi"
# moderation_stream = "Bottilaatikko"
# moderators = ["moderator@example.com"]

# PocketBase Integration (optional)
# [pocketbase]
# url = "https://data.palikkaharrastajat.fi"
# collection = "events"
# # Collection holding map locations (optional, defaults to "locations")
# locations_collection = "locations"

# LDraw part library, used to render /build models.
# Install it once with `make fetch-ldraw`; until then /build renders simple
# boxes instead of real part geometry.
# [ldraw]
# data_dir = "data/ldraw"
# library_url = "https://library.ldraw.org/library/updates/complete.zip"
# max_files = 200

# Sticky cache of part lookups, in its own SQLite database.
#
# Discord fires autocomplete on every keystroke, so the network can never be on
# that path. Instead every lookup the bot makes is kept, building a local index
# that answers instantly and survives restarts — the more the guild uses
# /part, the better its suggestions get.
#
# Everything in it is derived and disposable: deleting the file is a clean
# rebuild, which is exactly why it is not in bot.db.
# [parts_cache]
# enabled = true
# path = "sqlite:data/cache.db"
# search_ttl_days = 30      # a search that found something
# miss_ttl_mins = 60        # a search that found nothing
# warm_concurrency = 2
# warm_timeout_secs = 5

# [commands.events]
# enabled = true
# enable_edit = true
# enable_propose = true
# enable_fallback_mention = false

# [commands.locations]
# enabled = true
# enable_edit = true
# enable_propose = true
# enable_fallback_mention = false

# [commands.set]
# enabled = true

# Collaborative LEGO building in a thread. Off by default: it opens threads and
# listens to the conversation in them, so switch it on deliberately.
# Install the LDraw library with `make fetch-ldraw` for real part shapes;
# without it /build renders simple boxes.
# [commands.build]
# enabled = true
# session_ttl_hours = 24
# render_width = 800
# render_height = 600
# supersample = 2
# render_debounce_ms = 1200
# enable_io_export = true
# max_model_size = 10

# [[guilds]]
# guild_id = 1424873309325234220
# locale = "fi-FI"
#
# # Ambient assistant settings for this guild only (optional); each key left
# # out follows the global [ambient].
# [guilds.ambient]
# # Channels where ambient detection runs; omit to listen in every channel.
# channel_ids = [111111111111111111]
# set = false
# part = true
# debug_logging = true
#
# # Replaces the global [ambient.training_data] for this guild as a whole:
# # omitted fields take their defaults, not the global values.
# [guilds.ambient.training_data]
# enabled = true
# retention_days = 30
# store_raw_text = false
#
# # Override commands specifically for this guild (optional). A guild section
# # replaces the global one whole: flags left out take their defaults, and
# # enable_fallback_mention defaults to true.
# [guilds.commands.events]
# enabled = false
# enable_fallback_mention = false
# [guilds.commands.locations]
# enabled = false
# [guilds.commands.set]
# enabled = false
# [guilds.commands.build]
# enabled = false
#
# [[guilds]]
# guild_id = 987654321098765432
# locale = "en-US"
#
# # You can omit ambient or commands to use global defaults
# [guilds.commands.events]
# enabled = true
# enable_edit = true
# enable_propose = true
# enable_fallback_mention = false
#
# # Publish new feed articles to a channel of this guild (repeatable).
# # Each source is announced separately: up to three new articles of a source
# # are posted one message each, more are listed in one message for that
# # source. Only articles appearing after the bot was last (re)started are
# # announced.
# # Without feed_urls/opml_urls the section follows the global [feeds].
# [[guilds.feeds]]
# channel_id = 234567890123456789
# feed_urls = ["https://example.com/feed1.rss"]
# # opml_urls = ["https://example.com/feeds.opml"]
# # More domains or feed URLs to block for this channel only, added to the
# # global [feeds] defaults.
# # blocked_domains = ["kuvat.fi"]
# # blocked_feed_urls = ["https://example.com/unwanted.rss"]
# # Digest schedule for this channel only (see [feeds] schedule below).
# # schedule = "0 18 * * 1-5"
# # timezone = "UTC"

# [feeds]
# # Seconds between polls of each feed.
# # poll_interval = 3600
# # List of Feed URLs
# # feed_urls = [
# #     "https://example.com/feed2.rss"
# # ]
# # List of OPML URLs
# # opml_urls = ["https://example.com/feeds.opml"]
# # Feeds served from these domains (or their subdomains) are never published
# # to any channel; a [[guilds.feeds]] section can block more for its own.
# # blocked_domains = ["flickr.com"]
# # Complete feed URLs that are never published to any channel.
# # blocked_feed_urls = ["https://example.com/unwanted.rss"]
# # Send feed articles as a digest at these times instead of as soon as they
# # are found (cron, read in timezone). Overridable per [[guilds.feeds]]
# # section with schedule/timezone, where "instant" turns it back off.
# # schedule = "0 9 * * *"
# # timezone = "Europe/Helsinki"


