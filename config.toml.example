# Global bot name (optional)
# bot_name = "Palikkaharrastaja"
# Global default locale (optional; guild config wins, and "fi-FI" applies when neither is set)
# locale = "fi-FI"

# ambient_debug_logging = true
#
# [ambient_training_data]
# enabled = false
# retention_days = 30
# allowed_guild_ids = [123456789]

# poll_interval = 3600
# cache_ttl_secs = 600

# Zulip Integration (optional)
# [zulip]
# url = "https://forum.palikkaharrastajat.fi"
# bot_email = "palikkaharrastajat-bot@forum.palikkaharrastajat.fi"
# moderation_stream = "Bottilaatikko"
# moderators = ["moderator@example.com"]

# PocketBase Integration (optional)
# [pocketbase]
# url = "https://data.palikkaharrastajat.fi"
# collection = "events"
# # Collection holding map locations (optional, defaults to "locations")
# locations_collection = "locations"

# LDraw part library, used to render /build models.
# Install it once with `make fetch-ldraw`; until then /build renders simple
# boxes instead of real part geometry.
# [ldraw]
# data_dir = "data/ldraw"
# library_url = "https://library.ldraw.org/library/updates/complete.zip"
# max_files = 200

# Sticky cache of part lookups, in its own SQLite database.
#
# Discord fires autocomplete on every keystroke, so the network can never be on
# that path. Instead every lookup the bot makes is kept, building a local index
# that answers instantly and survives restarts — the more the guild uses
# /part, the better its suggestions get.
#
# Everything in it is derived and disposable: deleting the file is a clean
# rebuild, which is exactly why it is not in bot.db.
# [parts_cache]
# enabled = true
# path = "sqlite:data/cache.db"
# search_ttl_days = 30      # a search that found something
# miss_ttl_mins = 60        # a search that found nothing
# warm_concurrency = 2
# warm_timeout_secs = 5

# [interactions]
# set = true
# part = true

# [commands.events]
# enabled = true
# enable_edit = true
# enable_propose = true
# enable_fallback_mention = false

# [commands.locations]
# enabled = true
# enable_edit = true
# enable_propose = true
# enable_fallback_mention = false

# [commands.set]
# enabled = true

# Collaborative LEGO building in a thread. Off by default: it opens threads and
# listens to the conversation in them, so switch it on deliberately.
# Install the LDraw library with `make fetch-ldraw` for real part shapes;
# without it /build renders simple boxes.
# [commands.build]
# enabled = true
# session_ttl_hours = 24
# render_width = 800
# render_height = 600
# supersample = 2
# render_debounce_ms = 1200
# enable_io_export = true

# [[guilds]]
# guild_id = 1424873309325234220
# locale = "fi-FI"
# 
# # Override interactions specifically for this guild (optional)
# [guilds.interactions]
# set = false
# part = true
# 
# # Override commands specifically for this guild (optional)
# [guilds.commands.events]
# enabled = false
# [guilds.commands.locations]
# enabled = false
# [guilds.commands.set]
# enabled = false
# [guilds.commands.build]
# enabled = false
#
# [[guilds]]
# guild_id = 987654321098765432
# locale = "en-US"
#
# # You can omit interactions or commands to use global defaults
# [guilds.commands.events]
# enabled = true

# [[feeds]]
# # List of Feed URLs
# # feed_urls = [
# #     "https://example.com/feed2.rss"
# # ]
# # List of OPML URLs
# # opml_urls = ["https://example.com/feeds.opml"]
